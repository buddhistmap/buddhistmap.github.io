[
  {
    "id": "huyen-trang",
    "name": "Huyền Trang",
    "originalName": "玄奘 · Xuanzang",
    "aliases": [
      "Đường Tam Tạng",
      "Hsüan-tsang"
    ],
    "region": "Hán truyền",
    "period": "Thời Đường · thế kỷ VII",
    "description": "Dịch giả kinh điển sang Hán văn, nổi bật với Đại Bát-nhã, hệ thống Duy thức và các luận A-tì-đạt-ma.",
    "historicalSummary": "75 bộ kinh luận theo thư mục truyền thống",
    "scopeNote": "Danh mục này có 75 mục dịch thuật để tra cứu, gồm Hội Kim Cương nằm trong Đại Bát-nhã; các mục không phải 75 bộ độc lập, không trùng lặp về nội dung. Đại Đường Tây Vực Ký được liệt kê riêng là thuật ký. Tên Việt được chuyển từ nhan đề Hán để tra cứu, không khẳng định đã có bản dịch Việt tương ứng.",
