---
import Layout from '../../layouts/Layout.astro';
import { translators, translatorHref } from '../../lib/data';
---
<Layout title="Dịch giả kinh điển" description="Tra cứu các cao tăng dịch kinh của Việt Nam và truyền thống Hán dịch, tác phẩm và vị trí trên bản đồ kinh điển.">
  <nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span>/</span><span aria-current="page">Dịch giả</span></nav>
  <div class="page-kicker"><span>NHỮNG NGƯỜI NỐI NHỊP KINH ĐIỂN</span><span>{translators.length} HỒ SƠ</span></div>
  <h1>Qua một ngôn ngữ,<br/>mở thêm một <em>con đường.</em></h1>
  <p class="page-intro">Khám phá các bậc dịch giả, những bản kinh luận được chuyển ngữ và vị trí của chúng trong hệ thống kinh điển.</p>
  <div class="catalog-filters" id="translator-filters" hidden>
    <label>Tìm dịch giả<input id="translator-query" type="search" placeholder="Tên Việt, Hán hoặc phiên âm…"/></label>
    <label>Truyền thống dịch thuật<select id="translator-region"><option value="">Tất cả</option><option>Việt Nam</option><option>Hán truyền</option></select></label>
  </div>
  <p class="fine-print" id="translator-status" role="status" aria-live="polite">{translators.length} dịch giả trong danh mục khởi đầu</p>
  <div class="translator-grid">{translators.map((t,index)=><article class="translator-card" data-region={t.region} data-search={[t.name,t.originalName,...t.aliases].join(' ')}>
    <div class="card-top"><span class="eyebrow">{t.region}</span><span class="card-number">{String(index+1).padStart(2,'0')}</span></div>
    <h2><a href={translatorHref(t.id)}>{t.name}</a></h2><p class="translator-original">{t.originalName}</p><p class="translator-description">{t.description}</p>
    {t.historicalSummary && <p class="historical-count">{t.historicalSummary}</p>}
    <div class="translator-card-footer"><span>{t.works.filter(w=>w.role==='translation').length} mục dịch thuật đã ghi nhận</span><a href={translatorHref(t.id)}>Xem tác phẩm <span aria-hidden="true">↗</span></a></div>
  </article>)}</div>
  <p class="fine-print">Phân nhóm theo truyền thống dịch thuật, không mặc định quốc tịch. Số mục đã ghi nhận có thể gồm cả bộ kinh và bài kinh thuộc bộ ấy; không phải tổng số tác phẩm độc lập trong sự nghiệp của mỗi vị.</p>
</Layout>
<script>
import {normalize} from '../../lib/search';
const filters=document.getElementById('translator-filters')!; filters.hidden=false;
const query=document.querySelector<HTMLInputElement>('#translator-query')!,region=document.querySelector<HTMLSelectElement>('#translator-region')!;
const cards=[...document.querySelectorAll<HTMLElement>('.translator-card')];
function filter(){let count=0;for(const card of cards){const match=(!region.value||card.dataset.region===region.value)&&normalize(card.dataset.search!).includes(normalize(query.value));card.hidden=!match;if(match)count++;}document.getElementById('translator-status')!.textContent=count?`${count} dịch giả phù hợp`:'Không tìm thấy dịch giả. Thử tên khác hoặc bỏ bộ lọc.';}
query.addEventListener('input',filter);region.addEventListener('change',filter);
</script>
