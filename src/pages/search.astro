---
import Layout from '../layouts/Layout.astro';
import {searchEntries} from '../lib/data';
---
<Layout title="Tìm kiếm"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span>/</span><span>Tìm kiếm</span></nav><div class="page-kicker">TRA CỨU ĐA NGÔN NGỮ</div><h1>Tìm một bản kinh.</h1><p class="page-intro">Tìm theo tên Việt, Pāli, tiếng Anh, tên gọi khác hoặc mã định danh. Không cần gõ dấu.</p><form id="search-form" class="search-box" role="search"><span aria-hidden="true">⌕</span><label class="sr-only" for="query">Từ khóa tìm kiếm</label><input id="query" name="q" type="search" placeholder="Ví dụ: DN1, Niệm Xứ, Satipatthana"/><button type="submit">Tìm kiếm ↗</button></form><p id="search-status" role="status" aria-live="polite" class="fine-print"></p><div id="search-results" class="entity-list"></div><noscript><p>Hãy bật JavaScript để tìm kiếm tức thì, hoặc <a href="/texts/">duyệt danh mục văn bản</a>.</p></noscript><script id="search-data" type="application/json" set:html={JSON.stringify(searchEntries).replace(/</g,'\u003c')}/></Layout>
<script>
import {search,type SearchEntry} from '../lib/search';
const entries:SearchEntry[]=JSON.parse(document.getElementById('search-data')!.textContent!);
const input=document.querySelector<HTMLInputElement>('#query')!,results=document.getElementById('search-results')!,status=document.getElementById('search-status')!;
function render(){const query=input.value;const matches=search(entries,query);status.textContent=matches.length?`${matches.length} kết quả${query.trim()?` cho “${query.trim()}”`: ' trong chỉ mục'}`:'Không tìm thấy kết quả. Thử mã kinh hoặc tên ngắn hơn.';results.replaceChildren();for(const e of matches){const a=document.createElement('a');a.className='entity-row';a.href=e.url;const code=document.createElement('span');code.className='entity-code';code.textContent=e.identifier||e.type;const content=document.createElement('span');const title=document.createElement('strong');title.textContent=e.title;const path=document.createElement('small');path.textContent=e.path||'Truyền thống';content.append(title,path);const arrow=document.createElement('span');arrow.textContent='↗';arrow.setAttribute('aria-hidden','true');a.append(code,content,arrow);results.append(a);}}
input.value=new URLSearchParams(location.search).get('q')||'';render();input.addEventListener('input',render);document.getElementById('search-form')!.addEventListener('submit',event=>{event.preventDefault();history.replaceState(null,'',input.value?`?q=${encodeURIComponent(input.value)}`:location.pathname);render()});
</script>
