---
import type { Resource } from '../lib/schema';
interface Props { items: Resource[] }
const { items } = Astro.props;
const groups = [{label:'Đọc',types:['read','translation','original']},{label:'Nghe',types:['listen']},{label:'Xem',types:['video']},{label:'Tham khảo',types:['reference']}];
const languages: Record<string,string> = {vi:'Tiếng Việt',en:'Tiếng Anh',pli:'Pāli',zh:'Hán văn',bo:'Tiếng Tây Tạng'};
---
{groups.map(group => {const matches = items.filter(r=>group.types.includes(r.type)); return matches.length > 0 && <section class="resource-group"><h3>{group.label}</h3><div class="resource-grid">{matches.map(r=><a class="resource-card" href={r.url} target="_blank" rel="noopener noreferrer"><span class="eyebrow">{languages[r.language] || r.language}<span aria-hidden="true"> ↗</span></span><strong>{r.title}</strong><small>{r.provider} · Mở website nguồn</small>{r.description && <small>{r.description}</small>}</a>)}</div></section>})}
